// HoopTrack/Auth/BackendSecrets.swift.example
//
// COPY THIS FILE TO BackendSecrets.swift (drop the .example extension).
// BackendSecrets.swift is gitignored so your real values never leak into
// version control.
//
// The anon key is a client-public value — designed to be shipped in the app.
// It still lives in a gitignored file as a matter of hygiene.
//
// Two Supabase projects, picked by build configuration: Debug builds (Xcode
// runs, the simulator, CI) talk to development, Release builds (TestFlight,
// App Store) to production, so testing can never touch real users' data.
// Until a production project exists, put the same values in both.

import Foundation

nonisolated enum BackendSecrets {
    #if DEBUG
    /// Development project, e.g. https://<dev-project>.supabase.co
    static let supabaseURL = URL(string: "https://REPLACE-ME-DEV.supabase.co")!
    /// Development anon / public key — starts with "eyJ".
    /// Found in Supabase Dashboard → Settings → API.
    static let supabaseAnonKey = "REPLACE_ME_WITH_DEV_ANON_KEY"
    #else
    /// Production project.
    static let supabaseURL = URL(string: "https://REPLACE-ME-PROD.supabase.co")!
    static let supabaseAnonKey = "REPLACE_ME_WITH_PROD_ANON_KEY"
    #endif
}
